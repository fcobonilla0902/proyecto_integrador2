@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-2">
    <div class="row align-items-center text-center mb-2">
        <div class="col-2">
            <img src="~/imagenes/Portada/logo-uanl.png" alt="Logo UANL" style="width: 100px;">
