@{
    ViewData["Title"] = "Sin conexión";
    Layout = null;

    string titulo = ViewBag.Titulo ?? "No se pudo conectar con la API";
    string mensaje = ViewBag.Mensaje ?? "Verifica que API_Equipo1 esté ejecutándose e intenta nuevamente.";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card shadow-sm border-0 p-4 text-center" style="max-width: 520px; width: 100%;">
            <div class="mb-3">
                <span class="display-4 text-danger">⚠</span>
            </div>

            <h2 class="text-danger mb-3">@titulo</h2>

            <p class="text-muted mb-4">
                @mensaje
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center">
                <a href="javascript:location.reload()" class="btn btn-primary mb-2 mb-sm-0 mr-sm-2">
                    Reintentar
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                    Ir al inicio
                </a>
            </div>
        </div>
    </div>
</body>
</html>