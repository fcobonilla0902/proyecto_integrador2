@{
    ViewData["Title"] = "Nueva Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <!-- ============================================================
    =ESTILOS PARA ESTA PAGINA
    ===============================================================-->
    <link href="~/vendor/select2/select2.min.css" rel="stylesheet">

    <style>
        .select2 {
            width: 100% !important;
        }

        .table-responsive {
            border: 1px solid #e3e6f0;
            border-radius: 0.35rem;
        }

        .text-success {
            font-weight: bold;
        }
    </style>
}

<div class="row">
    <div class="col-sm-8">

        <!-- ================================
             SECCIÓN CLIENTE
        ==================================== -->
        <div class="row">
            <div class="col-sm-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 bg-second-primary">
                        <h6 class="m-0 font-weight-bold text-white">Cliente</h6>
                    </div>

                    <div class="card-body">

                        <!-- Buscar Cliente -->
                        <div class="form-row">
                            <div class="form-group col-sm-12">
                                <select class="form-control form-control-sm" id="cboBuscarCliente">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>

                        <!-- Nombre del Cliente -->
                        <div class="form-row">
                            <div class="form-group col-sm-12">
                                <input type="text" class="form-control form-control-sm" id="txtNombreCliente" placeholder="Nombre del Cliente">
                            </div>
                        </div>

                        <!-- Correo + RFC -->
                        <div class="form-row">
                            <div class="form-group col-sm-6">
                                <input type="text" class="form-control form-control-sm" id="txtCorreoCliente" placeholder="Correo electrónico">
                            </div>
                            <div class="form-group col-sm-6">
                                <input type="text" class="form-control form-control-sm" id="txtRfcCliente" placeholder="RFC">
                            </div>
                        </div>

                        <!-- Domicilio Fiscal + Régimen Fiscal -->
                        <div class="form-row">
                            <div class="form-group col-sm-6">
                                <input type="text" class="form-control form-control-sm" id="txtDomicilioFiscalCliente" placeholder="Domicilio Fiscal Receptor">
                            </div>
                            <div class="form-group col-sm-6">
                                <input type="text" class="form-control form-control-sm" id="txtRegimenFiscalCliente" placeholder="Régimen Fiscal Receptor">
                            </div>
                        </div>

                        <!-- Fecha Registro -->
                        <div class="form-row">
                            <div class="form-group col-sm-6">
                                <input type="text" class="form-control form-control-sm" id="txtFechaRegistroCliente" placeholder="Fecha Registro" disabled>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-md-4">
                                 <input type="text" id="txtPaisCliente" class="form-control" placeholder="País" readonly />
                             </div>
                            <div class="col-md-4">
                                 <input type="text" id="txtEstadoCliente" class="form-control" placeholder="Estado" readonly />
                            </div>
                        <div class="col-md-4">
                                 <input type="text" id="txtMunicipioCliente" class="form-control" placeholder="Municipio" readonly />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ================================
             SECCIÓN PRODUCTOS
        ==================================== -->
        <div class="row">
            <div class="col-sm-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 bg-second-primary">
                        <h6 class="m-0 font-weight-bold text-white">Productos</h6>
                    </div>
                    <div class="card-body">

                        <div class="form-row">
                            <div class="form-group col-sm-12">
                                <select class="form-control form-control-sm" id="cboBuscarProducto">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                    <table class="table table-striped table-sm" id="tbProducto">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th>Producto</th>
                                                <th>Cantidad</th>
                                                <th>Precio Unitario</th>
                                                <th>Sub Total</th>
                                                <th>Descuento</th>
                                                <th>Impuesto</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div> <!-- FIN col-sm-8 -->
    <!-- ================================
         SECCIÓN DETALLE
    ==================================== -->
    <div class="col-sm-4">

        <div class="row">
            <div class="col-sm-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 bg-second-primary">
                        <h6 class="m-0 font-weight-bold text-white">Detalle</h6>
                    </div>
                    <div class="card-body">

                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Tipo Documento</span>
                            </div>
                            <select class="form-control" id="cboTipoDocumento">
                                <option value="1">Ticket</option>
                                <option value="2">Factura</option>
                            </select>
                        </div>

                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Método Pago</span>
                            </div>
                            <select class="form-control" id="cboMetodoPago">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>

                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Uso CFDI</span>
                            </div>
                            <select class="form-control" id="cboUsoCFDI">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>

                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Forma Pago</span>
                            </div>
                            <select class="form-control" id="cboFormaPago">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>

                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Descuento</span>
                            </div>
                            <input type="text" class="form-control text-right" id="txtDescuento" disabled>
                        </div>

                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Sub Total</span>
                            </div>
                            <input type="text" class="form-control text-right" id="txtSubTotal" disabled>
                        </div>

                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text">IVA(16%)</span>
                            </div>
                            <input type="text" class="form-control text-right" id="txtIGV" disabled>
                        </div>

                        <div class="input-group input-group-sm mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Total</span>
                            </div>
                            <input type="text" class="form-control text-right" id="txtTotal" disabled>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Botón Terminar Venta -->
        <div class="row">
            <div class="col-sm-12">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="form-group mb-0">
                            <button class="btn btn-success btn-sm btn-block" id="btnTerminarVenta">Terminar Venta</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div> 
@section Scripts {
    <!-- ============================================================
    =SCRIPTS PARA ESTA PAGINA
    ===============================================================-->
    <script src="~/vendor/select2/select2.min.js"></script>
    <script src="~/vendor/select2/es.min.js"></script>

    <script src="~/js/vistas/Nueva_Venta.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
}